{
  // Cloudflare Workers static-assets config for artlifyagency.com
  "name": "artlify-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false
}
